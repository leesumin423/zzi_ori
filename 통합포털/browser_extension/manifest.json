  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://gw.eugenes.co.kr/*",
    "http://10.62.15.197:9000/*",
    "http://localhost:9000/*",
    "http://127.0.0.1:9000/*"
