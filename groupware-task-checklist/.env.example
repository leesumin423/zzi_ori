# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채우세요.
# .env 는 .gitignore 에 등록되어 있어 git에 절대 올라가지 않습니다.
#   cp .env.example .env      (Windows PowerShell: copy .env.example .env)

# ── 그룹웨어 로그인 ─────────────────────────────────────────
GW_LOGIN_URL=https://gw.eugenes.co.kr/covicore/login.do

# 자동 로그인(로그인 세션 만료 시 폴백)에 쓰입니다.
# 기본 방식은 login_setup.py 로 최초 1회 "직접" 로그인해서 세션을 저장하는 것이고,
# 이 값은 그 세션이 만료됐을 때만 보조로 사용됩니다. 비워두면 자동 로그인은 시도하지 않습니다.
GW_ID=
GW_PW=

# ── 조회할 화면 URL ─────────────────────────────────────────
# login_setup.py 로 로그인한 뒤, 브라우저에서 직접 해당 화면으로 이동해서
# 주소창에 뜨는 URL을 그대로 복사해 붙여넣으세요.
GW_MAIL_LIST_URL=

# 전자결재 - 부서함(완료함, 참조/회람함), 개인함(완료함, 참조/회람함)
GW_APPROVAL_DEPT_COMPLETED_URL=
GW_APPROVAL_DEPT_REFERENCE_URL=
GW_APPROVAL_PERSONAL_COMPLETED_URL=
GW_APPROVAL_PERSONAL_REFERENCE_URL=

# ── 조회 기간 / 필터 ────────────────────────────────────────
# 최근 며칠치 메일/결재문서를 뒤질지 (며칠 전 문서까지 "지난 마감" 후보로 볼지)
MAIL_LOOKBACK_DAYS=21
APPROVAL_LOOKBACK_DAYS=21

# 완전히 무시할 메일 제목/본문 키워드 (쉼표로 구분)
MAIL_SUBJECT_EXCLUDE=전표승인요청서

# ── 디버깅 옵션 ─────────────────────────────────────────────
# true 로 하면 브라우저 창이 실제로 보이면서 동작합니다 (선택자 문제 확인용)
HEADED=false
SLOWMO_MS=0

# 로그인 폼 선택자를 직접 알아냈다면 채워넣으세요 (비워두면 자동 탐지 시도)
LOGIN_ID_SELECTOR=
LOGIN_PW_SELECTOR=
LOGIN_SUBMIT_SELECTOR=
